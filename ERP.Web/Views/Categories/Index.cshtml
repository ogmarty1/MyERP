@model List<ERP.DataAccess.Models.Category>

@{
    ViewData["Title"] = Localizer["Categories"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Categories"]</h1>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Create New Category"]</a>
</div>

<table class="table table-striped table-hover table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Description"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@(category.Description ?? "-")</td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary" title="@Localizer["Edit"]">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline js-delete-form"
                              data-confirm-title="@Localizer["Delete Category"]"
                              data-confirm-text="@Localizer["Are you sure you want to delete this category?"] @Localizer["This action cannot be undone."]"
                              data-confirm-button="@Localizer["Yes, delete it"]"
                              data-cancel-button="@Localizer["Cancel"]">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="@Localizer["Delete"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
