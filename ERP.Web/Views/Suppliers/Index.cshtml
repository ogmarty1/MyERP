@model List<ERP.DataAccess.Models.Supplier>

@{
    ViewData["Title"] = Localizer["Suppliers"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Suppliers"]</h1>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Create New Supplier"]</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Company"]</th>
            <th>@Localizer["Contact Person"]</th>
            <th>@Localizer["Tax Number"]</th>
            <th>@Localizer["Phone"]</th>
            <th>@Localizer["Email"]</th>
            <th>@Localizer["Status"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Name</td>
                <td>@(supplier.CompanyName ?? "-")</td>
                <td>@(supplier.ContactPerson ?? "-")</td>
                <td>@supplier.TaxNumber</td>
                <td>@(supplier.Phone ?? "-")</td>
                <td>@(supplier.Email ?? "-")</td>
                <td>
                    @if (supplier.IsActive)
                    {
                        <span class="badge bg-success">@Localizer["Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Edit"]</a>
                    <a asp-action="Delete" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>
