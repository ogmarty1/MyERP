@model List<ERP.DataAccess.Models.Category>

@{
    ViewData["Title"] = Localizer["Categories"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Categories"]</h1>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Create New Category"]</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Description"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@(category.Description ?? "-")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Edit"]</a>
                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>
