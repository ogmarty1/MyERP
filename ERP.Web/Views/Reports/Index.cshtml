@model ERP.Web.Models.ReportsViewModel
@using ERP.BusinessLogic.DTOs
@using ERP.DataAccess.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = Localizer["Reports"];

    var groupingOptions = new List<SelectListItem>
    {
        new(Localizer["Daily"], ReportPeriodGrouping.Daily.ToString(), Model.Filter.Grouping == ReportPeriodGrouping.Daily),
        new(Localizer["Monthly"], ReportPeriodGrouping.Monthly.ToString(), Model.Filter.Grouping == ReportPeriodGrouping.Monthly)
    };

    var showDateFilter = Model.ActiveType != ReportType.LowStock;
    var showGrouping = Model.ActiveType is ReportType.SalesOverview or ReportType.PurchasesOverview;

    string MenuClass(ReportType type) => Model.ActiveType == type
        ? "list-group-item list-group-item-action active"
        : "list-group-item list-group-item-action";

    string BadgeClass(MovementType type) => type switch
    {
        MovementType.Inflow => "bg-success",
        MovementType.Outflow => "bg-danger",
        MovementType.Adjustment => "bg-secondary",
        _ => "bg-secondary"
    };

    string MovementText(MovementType type) => type switch
    {
        MovementType.Inflow => Localizer["Inflow"],
        MovementType.Outflow => Localizer["Outflow"],
        MovementType.Adjustment => Localizer["Adjustment"],
        _ => type.ToString()
    };

    var totalRevenue = Model.SalesByPeriod.Sum(i => i.TotalRevenue);
    var totalOrders = Model.SalesByPeriod.Sum(i => i.OrderCount);
    var totalQuantitySold = Model.SalesByCategory.Sum(i => i.QuantitySold);
    var topCategory = Model.SalesByCategory.OrderByDescending(i => i.TotalRevenue).FirstOrDefault();

    var totalSpend = Model.PurchasesByPeriod.Sum(i => i.TotalSpend);
    var totalPurchaseOrders = Model.PurchasesByPeriod.Sum(i => i.PurchaseOrderCount);
    var totalQuantityPurchased = Model.PurchasesBySupplier.Sum(i => i.QuantityPurchased);
    var topSupplier = Model.PurchasesBySupplier.OrderByDescending(i => i.TotalSpend).FirstOrDefault();

    var totalShortfall = Model.LowStock.Sum(i => i.Shortfall);
    var affectedCategories = Model.LowStock.Select(i => i.CategoryName).Distinct().Count();

    var profitRevenue = Model.ProductProfitability.Sum(i => i.TotalRevenue);
    var profitCost = Model.ProductProfitability.Sum(i => i.TotalCost);
    var grossProfit = Model.ProductProfitability.Sum(i => i.GrossProfit);
    var avgMargin = profitRevenue == 0 ? 0 : Math.Round((grossProfit / profitRevenue) * 100, 2);

    var totalCustomersWithOrders = Model.TopCustomers.Count;
    var customersRevenue = Model.TopCustomers.Sum(i => i.TotalRevenue);
    var customersOrders = Model.TopCustomers.Sum(i => i.OrderCount);
    var overallAvgOrderValue = customersOrders == 0 ? 0 : Math.Round(customersRevenue / customersOrders, 2);
    var topCustomer = Model.TopCustomers.OrderByDescending(i => i.TotalRevenue).FirstOrDefault();

    var totalInflow = Model.InventoryMovements.Where(m => m.MovementType == MovementType.Inflow).Sum(m => m.Quantity);
    var totalOutflow = Model.InventoryMovements.Where(m => m.MovementType == MovementType.Outflow).Sum(m => m.Quantity);
    var netChange = totalInflow - totalOutflow;

    var employeeRevenue = Model.SalesByEmployee.Sum(i => i.TotalRevenue);
    var employeeOrders = Model.SalesByEmployee.Sum(i => i.OrderCount);
    var topEmployee = Model.SalesByEmployee.OrderByDescending(i => i.TotalRevenue).FirstOrDefault();
}

<h1 class="mb-4">@Localizer["Reports"]</h1>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row">
    <div class="col-lg-3 mb-4">
        <h6 class="text-muted text-uppercase small mb-2">@Localizer["Sales & Purchases"]</h6>
        <div class="list-group mb-4">
            <a class="@MenuClass(ReportType.SalesOverview)" asp-action="Index" asp-route-type="@ReportType.SalesOverview"
               asp-route-StartDate="@Model.Filter.StartDate" asp-route-EndDate="@Model.Filter.EndDate" asp-route-Grouping="@Model.Filter.Grouping">
                <i class="bi bi-graph-up-arrow me-2"></i>@Localizer["Sales Overview"]
            </a>
            <a class="@MenuClass(ReportType.PurchasesOverview)" asp-action="Index" asp-route-type="@ReportType.PurchasesOverview"
               asp-route-StartDate="@Model.Filter.StartDate" asp-route-EndDate="@Model.Filter.EndDate" asp-route-Grouping="@Model.Filter.Grouping">
                <i class="bi bi-truck me-2"></i>@Localizer["Purchases Overview"]
            </a>
        </div>

        <h6 class="text-muted text-uppercase small mb-2">@Localizer["Business Insights"]</h6>
        <div class="list-group">
            <a class="@MenuClass(ReportType.LowStock)" asp-action="Index" asp-route-type="@ReportType.LowStock">
                <i class="bi bi-exclamation-triangle me-2"></i>@Localizer["Low Stock"]
            </a>
            <a class="@MenuClass(ReportType.ProductProfitability)" asp-action="Index" asp-route-type="@ReportType.ProductProfitability"
               asp-route-StartDate="@Model.Filter.StartDate" asp-route-EndDate="@Model.Filter.EndDate">
                <i class="bi bi-piggy-bank me-2"></i>@Localizer["Product Profitability"]
            </a>
            <a class="@MenuClass(ReportType.TopCustomers)" asp-action="Index" asp-route-type="@ReportType.TopCustomers"
               asp-route-StartDate="@Model.Filter.StartDate" asp-route-EndDate="@Model.Filter.EndDate">
                <i class="bi bi-people me-2"></i>@Localizer["Top Customers"]
            </a>
            <a class="@MenuClass(ReportType.InventoryMovements)" asp-action="Index" asp-route-type="@ReportType.InventoryMovements"
               asp-route-StartDate="@Model.Filter.StartDate" asp-route-EndDate="@Model.Filter.EndDate">
                <i class="bi bi-arrow-left-right me-2"></i>@Localizer["Inventory Movements"]
            </a>
            <a class="@MenuClass(ReportType.SalesByEmployee)" asp-action="Index" asp-route-type="@ReportType.SalesByEmployee"
               asp-route-StartDate="@Model.Filter.StartDate" asp-route-EndDate="@Model.Filter.EndDate">
                <i class="bi bi-person-badge me-2"></i>@Localizer["Sales by Employee"]
            </a>
        </div>
    </div>

    <div class="col-lg-9">
        @if (showDateFilter)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <form asp-action="Index" method="get" class="row g-3 align-items-end">
                        <input type="hidden" name="type" value="@Model.ActiveType" />
                        <div class="col-auto">
                            <label asp-for="Filter.StartDate" class="form-label">@Localizer["Start Date"]</label>
                            <input asp-for="Filter.StartDate" class="form-control" />
                        </div>
                        <div class="col-auto">
                            <label asp-for="Filter.EndDate" class="form-label">@Localizer["End Date"]</label>
                            <input asp-for="Filter.EndDate" class="form-control" />
                        </div>
                        @if (showGrouping)
                        {
                            <div class="col-auto">
                                <label asp-for="Filter.Grouping" class="form-label">@Localizer["Group By"]</label>
                                <select asp-for="Filter.Grouping" asp-items="groupingOptions" class="form-select"></select>
                            </div>
                        }
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">@Localizer["Filter"]</button>
                            <a asp-action="Index" asp-route-type="@Model.ActiveType" class="btn btn-outline-secondary">@Localizer["Clear"]</a>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (Model.ActiveType == ReportType.SalesOverview)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Total Revenue"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@totalRevenue.ToEuro()</p>
                            </div>
                            <i class="bi bi-currency-exchange kpi-icon text-success"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Total Orders"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@totalOrders</p>
                            </div>
                            <i class="bi bi-cart-check kpi-icon text-primary"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Quantity Sold"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@totalQuantitySold</p>
                            </div>
                            <i class="bi bi-boxes kpi-icon text-info"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Top Category"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@(topCategory?.CategoryName ?? "-")</p>
                            </div>
                            <i class="bi bi-award kpi-icon text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.SalesByPeriod.Count > 0 || Model.SalesByCategory.Count > 0)
            {
                <div class="row g-3 mb-4">
                    <div class="col-lg-7">
                        <div class="card chart-card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="card-title text-muted mb-3">@Localizer["Sales by Period"]</h6>
                                <canvas id="salesByPeriodChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="card chart-card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="card-title text-muted mb-3">@Localizer["Sales by Category"]</h6>
                                <canvas id="salesByCategoryChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="row">
                <div class="col-lg-6 mb-4">
                    <h4 class="mb-3">@Localizer["Sales by Period"]</h4>
                    @if (Model.SalesByPeriod.Count == 0)
                    {
                        <p class="text-muted">@Localizer["No sales found for the selected range."]</p>
                    }
                    else
                    {
                        <table id="salesByPeriodTable" class="table table-striped table-bordered align-middle w-100">
                            <thead class="table-light">
                                <tr>
                                    <th>@Localizer["Period"]</th>
                                    <th>@Localizer["Order Count"]</th>
                                    <th>@Localizer["Total Revenue"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SalesByPeriod)
                                {
                                    <tr>
                                        <td>@item.PeriodLabel</td>
                                        <td>@item.OrderCount</td>
                                        <td data-order="@item.TotalRevenue">@item.TotalRevenue.ToEuro()</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td>@Localizer["Total"]</td>
                                    <td>@totalOrders</td>
                                    <td>@totalRevenue.ToEuro()</td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>

                <div class="col-lg-6 mb-4">
                    <h4 class="mb-3">@Localizer["Sales by Category"]</h4>
                    @if (Model.SalesByCategory.Count == 0)
                    {
                        <p class="text-muted">@Localizer["No sales found for the selected range."]</p>
                    }
                    else
                    {
                        <table id="salesByCategoryTable" class="table table-striped table-bordered align-middle w-100">
                            <thead class="table-light">
                                <tr>
                                    <th>@Localizer["Category"]</th>
                                    <th>@Localizer["Quantity Sold"]</th>
                                    <th>@Localizer["Total Revenue"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SalesByCategory)
                                {
                                    <tr>
                                        <td>@item.CategoryName</td>
                                        <td>@item.QuantitySold</td>
                                        <td data-order="@item.TotalRevenue">@item.TotalRevenue.ToEuro()</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td>@Localizer["Total"]</td>
                                    <td>@totalQuantitySold</td>
                                    <td>@Model.SalesByCategory.Sum(i => i.TotalRevenue).ToEuro()</td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
            </div>
        }

        @if (Model.ActiveType == ReportType.PurchasesOverview)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Total Spend"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@totalSpend.ToEuro()</p>
                            </div>
                            <i class="bi bi-cash-stack kpi-icon text-danger"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Total Purchase Orders"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@totalPurchaseOrders</p>
                            </div>
                            <i class="bi bi-truck kpi-icon text-primary"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Quantity Purchased"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@totalQuantityPurchased</p>
                            </div>
                            <i class="bi bi-boxes kpi-icon text-info"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Top Supplier"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@(topSupplier?.SupplierName ?? "-")</p>
                            </div>
                            <i class="bi bi-award kpi-icon text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.PurchasesByPeriod.Count > 0 || Model.PurchasesBySupplier.Count > 0)
            {
                <div class="row g-3 mb-4">
                    <div class="col-lg-7">
                        <div class="card chart-card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="card-title text-muted mb-3">@Localizer["Purchases by Period"]</h6>
                                <canvas id="purchasesByPeriodChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="card chart-card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="card-title text-muted mb-3">@Localizer["Purchases by Supplier"]</h6>
                                <canvas id="purchasesBySupplierChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="row">
                <div class="col-lg-6 mb-4">
                    <h4 class="mb-3">@Localizer["Purchases by Period"]</h4>
                    @if (Model.PurchasesByPeriod.Count == 0)
                    {
                        <p class="text-muted">@Localizer["No purchases found for the selected range."]</p>
                    }
                    else
                    {
                        <table id="purchasesByPeriodTable" class="table table-striped table-bordered align-middle w-100">
                            <thead class="table-light">
                                <tr>
                                    <th>@Localizer["Period"]</th>
                                    <th>@Localizer["Purchase Order Count"]</th>
                                    <th>@Localizer["Total Spend"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PurchasesByPeriod)
                                {
                                    <tr>
                                        <td>@item.PeriodLabel</td>
                                        <td>@item.PurchaseOrderCount</td>
                                        <td data-order="@item.TotalSpend">@item.TotalSpend.ToEuro()</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td>@Localizer["Total"]</td>
                                    <td>@totalPurchaseOrders</td>
                                    <td>@totalSpend.ToEuro()</td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>

                <div class="col-lg-6 mb-4">
                    <h4 class="mb-3">@Localizer["Purchases by Supplier"]</h4>
                    @if (Model.PurchasesBySupplier.Count == 0)
                    {
                        <p class="text-muted">@Localizer["No purchases found for the selected range."]</p>
                    }
                    else
                    {
                        <table id="purchasesBySupplierTable" class="table table-striped table-bordered align-middle w-100">
                            <thead class="table-light">
                                <tr>
                                    <th>@Localizer["Supplier"]</th>
                                    <th>@Localizer["Quantity Purchased"]</th>
                                    <th>@Localizer["Total Spend"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PurchasesBySupplier)
                                {
                                    <tr>
                                        <td>@item.SupplierName</td>
                                        <td>@item.QuantityPurchased</td>
                                        <td data-order="@item.TotalSpend">@item.TotalSpend.ToEuro()</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td>@Localizer["Total"]</td>
                                    <td>@totalQuantityPurchased</td>
                                    <td>@Model.PurchasesBySupplier.Sum(i => i.TotalSpend).ToEuro()</td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
            </div>
        }

        @if (Model.ActiveType == ReportType.LowStock)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Critical Items"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@Model.LowStock.Count</p>
                            </div>
                            <i class="bi bi-exclamation-triangle kpi-icon text-danger"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Total Shortfall"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@totalShortfall</p>
                            </div>
                            <i class="bi bi-boxes kpi-icon text-warning"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Categories Affected"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@affectedCategories</p>
                            </div>
                            <i class="bi bi-tags kpi-icon text-info"></i>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.LowStock.Count == 0)
            {
                <p class="text-muted">@Localizer["No low stock items found."]</p>
            }
            else
            {
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div class="card chart-card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="card-title text-muted mb-3">@Localizer["Low Stock"]</h6>
                                <canvas id="lowStockChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <table id="lowStockTable" class="table table-striped table-bordered align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["Product"]</th>
                            <th>@Localizer["SKU"]</th>
                            <th>@Localizer["Category"]</th>
                            <th>@Localizer["In Stock"]</th>
                            <th>@Localizer["Minimum"]</th>
                            <th>@Localizer["Shortfall"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.LowStock)
                        {
                            <tr class="@(item.QuantityInStock <= item.MinimumQuantity ? "table-danger" : "")">
                                <td>@item.ProductName</td>
                                <td>@item.SKU</td>
                                <td>@item.CategoryName</td>
                                <td>@item.QuantityInStock</td>
                                <td>@item.MinimumQuantity</td>
                                <td>@item.Shortfall</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }

        @if (Model.ActiveType == ReportType.ProductProfitability)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Total Revenue"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@profitRevenue.ToEuro()</p>
                            </div>
                            <i class="bi bi-currency-exchange kpi-icon text-success"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Total Cost"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@profitCost.ToEuro()</p>
                            </div>
                            <i class="bi bi-cash-stack kpi-icon text-danger"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Gross Profit"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@grossProfit.ToEuro()</p>
                            </div>
                            <i class="bi bi-piggy-bank kpi-icon text-primary"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Avg Margin"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@avgMargin%</p>
                            </div>
                            <i class="bi bi-percent kpi-icon text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.ProductProfitability.Count == 0)
            {
                <p class="text-muted">@Localizer["No profitability data found for the selected range."]</p>
            }
            else
            {
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div class="card chart-card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="card-title text-muted mb-3">@Localizer["Gross Profit by Product"]</h6>
                                <canvas id="profitabilityChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <table id="profitabilityTable" class="table table-striped table-bordered align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["Product"]</th>
                            <th>@Localizer["SKU"]</th>
                            <th>@Localizer["Category"]</th>
                            <th>@Localizer["Quantity Sold"]</th>
                            <th>@Localizer["Total Revenue"]</th>
                            <th>@Localizer["Total Cost"]</th>
                            <th>@Localizer["Gross Profit"]</th>
                            <th>@Localizer["Margin %"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ProductProfitability)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.SKU</td>
                                <td>@item.CategoryName</td>
                                <td>@item.QuantitySold</td>
                                <td data-order="@item.TotalRevenue">@item.TotalRevenue.ToEuro()</td>
                                <td data-order="@item.TotalCost">@item.TotalCost.ToEuro()</td>
                                <td data-order="@item.GrossProfit">@item.GrossProfit.ToEuro()</td>
                                <td>@item.MarginPercent%</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td colspan="3">@Localizer["Total"]</td>
                            <td>@Model.ProductProfitability.Sum(i => i.QuantitySold)</td>
                            <td>@profitRevenue.ToEuro()</td>
                            <td>@profitCost.ToEuro()</td>
                            <td>@grossProfit.ToEuro()</td>
                            <td>@avgMargin%</td>
                        </tr>
                    </tfoot>
                </table>
            }
        }

        @if (Model.ActiveType == ReportType.TopCustomers)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
