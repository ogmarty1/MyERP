@model List<ERP.DataAccess.Models.Category>

@{
    ViewData["Title"] = Localizer["Categories"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Categories"]</h1>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Create New Category"]</a>
</div>

<table class="table table-striped table-hover table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Description"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@category.Id">@category.Name</a></td>
                <td>@(category.Description ?? "-")</td>
            </tr>
        }
    </tbody>
</table>
