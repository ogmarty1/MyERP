@model ERP.Web.Models.SupplierFormViewModel

@{
    ViewData["Title"] = Localizer["Create Supplier"];
}

<h1>@Localizer["Create Supplier"]</h1>

<form asp-action="Create" method="post" class="js-submit-loading">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @await Html.PartialAsync("_SupplierForm", Model)
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
