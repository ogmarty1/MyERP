@model ERP.Web.Models.CustomerFormViewModel

@{
    ViewData["Title"] = Localizer["Edit Customer"];
}

<h1>@Localizer["Edit Customer"]</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="js-submit-loading">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @await Html.PartialAsync("_CustomerForm", Model)
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
