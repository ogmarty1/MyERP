@model ERP.Web.Models.ProductDetailsViewModel
@using ERP.DataAccess.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = Model.Form.Name;
    var canManage = User.IsInRole("Manager") || User.IsInRole("Admin");
    var forceEdit = ViewData["ForceEditMode"] is true;

    var statusOptions = new List<SelectListItem>
    {
        new(Localizer["Active"], ProductStatus.Active.ToString(), Model.Form.Status == ProductStatus.Active),
        new(Localizer["Discontinued"], ProductStatus.Discontinued.ToString(), Model.Form.Status == ProductStatus.Discontinued),
        new(Localizer["Out Of Stock"], ProductStatus.OutOfStock.ToString(), Model.Form.Status == ProductStatus.OutOfStock)
    };

    string BadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-warning text-dark",
        OrderStatus.Shipped => "bg-primary",
        OrderStatus.Completed => "bg-success",
        OrderStatus.OnHold => "bg-secondary",
        OrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };

    string StatusText(OrderStatus status) => status switch
    {
        OrderStatus.Pending => Localizer["Pending"],
        OrderStatus.Shipped => Localizer["Shipped"],
        OrderStatus.Completed => Localizer["Completed"],
        OrderStatus.OnHold => Localizer["On Hold"],
        OrderStatus.Cancelled => Localizer["Cancelled"],
        _ => status.ToString()
    };
}

<div class="js-details-form-wrapper" data-force-edit="@(forceEdit ? "true" : "false")">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>@Model.Form.Name</h1>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back to Products"]</a>
            @if (canManage)
            {
                <span class="js-view-actions">
                    <button type="button" class="btn btn-primary js-edit-toggle">@Localizer["Edit"]</button>
                    <form asp-action="Delete" asp-route-id="@Model.Form.Id" method="post" class="d-inline js-delete-form"
                          data-confirm-title="@Localizer["Delete Product"]"
                          data-confirm-text="@Localizer["Are you sure you want to delete this product?"] @Localizer["This action cannot be undone."]"
                          data-confirm-button="@Localizer["Yes, delete it"]"
                          data-cancel-button="@Localizer["Cancel"]">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i> @Localizer["Delete"]
                        </button>
                    </form>
                </span>
                <span class="js-edit-actions d-none">
                    <button type="submit" form="productDetailsForm" class="btn btn-success">@Localizer["Save"]</button>
                    <button type="button" class="btn btn-outline-secondary js-edit-cancel">@Localizer["Cancel"]</button>
                </span>
            }
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form id="productDetailsForm" asp-action="Edit" asp-route-id="@Model.Form.Id" method="post" class="js-details-form">
        <input type="hidden" asp-for="Form.Id" />

        <div class="row">
            <div class="col-lg-6">
                <fieldset class="erp-field-group erp-field-group--primary">
                    <legend>@Localizer["Basic Info"]</legend>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Form.Name" class="form-label">@Localizer["Name"]</label>
                            <input asp-for="Form.Name" class="form-control erp-editable" readonly />
                            <span asp-validation-for="Form.Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Form.SKU" class="form-label">@Localizer["SKU"]</label>
                            <input asp-for="Form.SKU" class="form-control erp-editable" readonly />
                            <span asp-validation-for="Form.SKU" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Form.CategoryId" class="form-label">@Localizer["Category"]</label>
                            <select asp-for="Form.CategoryId" class="form-select erp-editable" asp-items="Model.Form.Categories" disabled>
                                <option value="">-- @Localizer["Select Category"] --</option>
                            </select>
                            <span asp-validation-for="Form.CategoryId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Form.SupplierId" class="form-label">@Localizer["Supplier"]</label>
                            <select asp-for="Form.SupplierId" class="form-select erp-editable" asp-items="Model.Form.Suppliers" disabled>
                                <option value="">-- @Localizer["Select Supplier"] --</option>
                            </select>
                            <span asp-validation-for="Form.SupplierId" class="text-danger"></span>
                        </div>
                        <div class="col-12 mb-3">
                            <label asp-for="Form.Description" class="form-label">@Localizer["Description"]</label>
                            <textarea asp-for="Form.Description" class="form-control erp-editable" rows="3" readonly></textarea>
                            <span asp-validation-for="Form.Description" class="text-danger"></span>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="erp-field-group erp-field-group--info">
                    <legend>@Localizer["Notes"]</legend>
                    <textarea asp-for="Form.Notes" class="form-control erp-editable" rows="3" readonly></textarea>
                    <span asp-validation-for="Form.Notes" class="text-danger"></span>
                </fieldset>
            </div>

            <div class="col-lg-6">
                <fieldset class="erp-field-group erp-field-group--success">
                    <legend>@Localizer["Pricing"]</legend>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Form.PurchasePrice" class="form-label">@Localizer["Purchase Price"]</label>
                            <input asp-for="Form.PurchasePrice" class="form-control erp-editable" type="number" step="0.01" readonly />
                            <span asp-validation-for="Form.PurchasePrice" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Form.SalePrice" class="form-label">@Localizer["Sale Price"]</label>
                            <input asp-for="Form.SalePrice" class="form-control erp-editable" type="number" step="0.01" readonly />
                            <span asp-validation-for="Form.SalePrice" class="text-danger"></span>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="erp-field-group erp-field-group--warning">
                    <legend>@Localizer["Inventory"]</legend>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Form.QuantityInStock" class="form-label">@Localizer["Quantity In Stock"]</label>
                            <input asp-for="Form.QuantityInStock" class="form-control erp-editable" type="number" step="1" readonly />
                            <span asp-validation-for="Form.QuantityInStock" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Form.MinimumQuantity" class="form-label">@Localizer["Minimum Quantity"]</label>
                            <input asp-for="Form.MinimumQuantity" class="form-control erp-editable" type="number" step="1" readonly />
                            <span asp-validation-for="Form.MinimumQuantity" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Form.Status" class="form-label">@Localizer["Status"]</label>
                            <select asp-for="Form.Status" class="form-select erp-editable" asp-items="statusOptions" disabled></select>
                            <span asp-validation-for="Form.Status" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="Form.IsActive" class="form-check-input erp-editable" disabled />
                                <label asp-for="Form.IsActive" class="form-check-label">@Localizer["Active"]</label>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
    </form>

    <fieldset class="erp-field-group erp-field-group--secondary">
        <legend>@Localizer["Order History"]</legend>
        @if (Model.OrderHistory.Count == 0)
        {
            <p class="text-muted mb-0">@Localizer["This product has not been included in any orders yet."]</p>
        }
        else
        {
            <table id="orderHistoryTable" class="table table-striped table-bordered align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["Order ID"]</th>
                        <th>@Localizer["Order Date"]</th>
                        <th>@Localizer["Total Amount"]</th>
                        <th>@Localizer["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.OrderHistory)
                    {
                        <tr>
                            <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">@order.Id</a></td>
                            <td data-order="@order.OrderDate.ToString("o")">@order.OrderDate.ToLocalTime().ToString("g")</td>
                            <td data-order="@order.TotalAmount">@order.TotalAmount.ToEuro()</td>
                            <td><span class="badge @BadgeClass(order.Status)">@StatusText(order.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </fieldset>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            if ($('.js-details-form-wrapper').data('force-edit')) {
                $('.js-edit-toggle').trigger('click');
            }

            if ($('#orderHistoryTable').length) {
                $('#orderHistoryTable').DataTable({
                    language: window.dataTableLanguage,
                    order: [[1, 'desc']]
                });
            }
        });
    </script>
}
