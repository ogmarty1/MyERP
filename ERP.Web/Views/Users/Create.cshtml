@model ERP.Web.Models.UserFormViewModel

@{
    ViewData["Title"] = Localizer["Create User"];
}

<h1>@Localizer["Create User"]</h1>

<form asp-action="Create" method="post" class="js-submit-loading">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @await Html.PartialAsync("_UserForm", Model)
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
