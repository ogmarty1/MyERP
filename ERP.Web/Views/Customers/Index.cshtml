@model List<ERP.DataAccess.Models.Customer>

@{
    ViewData["Title"] = Localizer["Customers"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Customers"]</h1>
    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">@Localizer["Create New Customer"]</a>
    }
</div>

<table id="customersTable" class="table table-striped table-hover table-bordered align-middle w-100">
    <thead class="table-light">
        <tr>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Company"]</th>
            <th>@Localizer["Phone"]</th>
            <th>@Localizer["Email"]</th>
            <th>@Localizer["Address"]</th>
            <th>@Localizer["Status"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.Name</td>
                <td>@(customer.CompanyName ?? "-")</td>
                <td>@(customer.Phone ?? "-")</td>
                <td>@(customer.Email ?? "-")</td>
                <td>@(customer.Address ?? "-")</td>
                <td>
                    @if (customer.IsActive)
                    {
                        <span class="badge bg-success">@Localizer["Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                    }
                </td>
                <td>
                    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                    {
                        <div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary" title="@Localizer["Edit"]">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="d-inline js-delete-form"
                                  data-confirm-title="@Localizer["Delete Customer"]"
                                  data-confirm-text="@Localizer["Are you sure you want to delete this customer?"] @Localizer["This action cannot be undone."]"
                                  data-confirm-button="@Localizer["Yes, delete it"]"
                                  data-cancel-button="@Localizer["Cancel"]">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@Localizer["Delete"]">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(function () {
            $('#customersTable').DataTable({
                language: window.dataTableLanguage,
                columnDefs: [{ orderable: false, targets: -1 }]
            });
        });
    </script>
}
