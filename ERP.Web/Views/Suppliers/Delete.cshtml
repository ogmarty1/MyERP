@model ERP.DataAccess.Models.Supplier

@{
    ViewData["Title"] = Localizer["Delete Supplier"];
}

<h1>@Localizer["Delete Supplier"]</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<p>@Localizer["Are you sure you want to delete this supplier?"]</p>

<dl class="row">
    <dt class="col-sm-2">@Localizer["Name"]</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">@Localizer["Company"]</dt>
    <dd class="col-sm-10">@(Model.CompanyName ?? "-")</dd>

    <dt class="col-sm-2">@Localizer["Contact Person"]</dt>
    <dd class="col-sm-10">@(Model.ContactPerson ?? "-")</dd>

    <dt class="col-sm-2">@Localizer["Tax Number"]</dt>
    <dd class="col-sm-10">@Model.TaxNumber</dd>

    <dt class="col-sm-2">@Localizer["Phone"]</dt>
    <dd class="col-sm-10">@(Model.Phone ?? "-")</dd>

    <dt class="col-sm-2">@Localizer["Email"]</dt>
    <dd class="col-sm-10">@(Model.Email ?? "-")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
    <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
</form>
