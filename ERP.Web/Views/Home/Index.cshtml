@model ERP.BusinessLogic.DTOs.DashboardViewModel

@{
    ViewData["Title"] = Localizer["Dashboard"];
}

<h1 class="mb-4">@Localizer["Dashboard"]</h1>

@if (User.IsInRole("Manager") || User.IsInRole("Admin"))
{
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="card-title text-muted mb-1">@Localizer["Monthly Revenue"]</h6>
                        <p class="card-text fs-4 fw-bold mb-0">@Model.MonthlyRevenue.ToEuro()</p>
                    </div>
                    <i class="bi bi-currency-exchange kpi-icon text-success"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="card-title text-muted mb-1">@Localizer["New Orders (Month)"]</h6>
                        <p class="card-text fs-4 fw-bold mb-0">@Model.NewMonthlyOrdersCount</p>
                    </div>
                    <i class="bi bi-cart-check kpi-icon text-primary"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="card-title text-muted mb-1">@Localizer["Active Customers"]</h6>
                        <p class="card-text fs-4 fw-bold mb-0">@Model.TotalActiveCustomers</p>
                    </div>
                    <i class="bi bi-people kpi-icon text-info"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="card-title text-muted mb-1">@Localizer["Critical Stock"]</h6>
                        <p class="card-text fs-4 fw-bold mb-0">@Model.CriticalStockCount</p>
                    </div>
                    <i class="bi bi-exclamation-triangle kpi-icon text-danger"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card chart-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="card-title text-muted mb-3">@Localizer["Monthly Sales Trends (Last 12 Months)"]</h6>
                    <canvas id="salesTrendChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card chart-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="card-title text-muted mb-3">@Localizer["Top 5 Best-Selling Products"]</h6>
                    <canvas id="topProductsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">@Localizer["Low Stock Alerts"]</h4>
    @if (Model.LowStockProducts.Count == 0)
    {
        <p class="text-muted">@Localizer["No products are currently low on stock."]</p>
    }
    else
    {
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["SKU"]</th>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Category"]</th>
                    <th>@Localizer["Quantity In Stock"]</th>
                    <th>@Localizer["Minimum Quantity"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.LowStockProducts)
                {
                    <tr class="table-danger">
                        <td>@product.SKU</td>
                        <td>@product.Name</td>
                        <td>@product.Category?.Name</td>
                        <td>@product.QuantityInStock</td>
                        <td>@product.MinimumQuantity</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <script>
            const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesTrend.Select(m => m.Label)));
            const trendRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesTrend.Select(m => m.Revenue)));
            const topProductNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSellingProducts.Select(p => p.ProductName)));
            const topProductRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSellingProducts.Select(p => p.Revenue)));

            new Chart(document.getElementById('salesTrendChart'), {
                type: 'line',
                data: {
                    labels: trendLabels,
                    datasets: [{
                        label: '@Html.Raw(Localizer["Revenue (€)"])',
                        data: trendRevenue,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.15)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });

            new Chart(document.getElementById('topProductsChart'), {
                type: 'doughnut',
                data: {
                    labels: topProductNames,
                    datasets: [{
                        data: topProductRevenue,
                        backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        </script>
    }
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="card-title text-muted mb-1">@Localizer["My Orders"]</h6>
                        <p class="card-text fs-4 fw-bold mb-0">@Model.MyOrdersCount</p>
                    </div>
                    <i class="bi bi-cart kpi-icon text-primary"></i>
                </div>
            </div>
        </div>
    </div>
}
