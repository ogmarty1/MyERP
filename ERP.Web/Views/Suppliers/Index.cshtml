@model ERP.Web.Models.SuppliersIndexViewModel

@{
    ViewData["Title"] = Localizer["Suppliers"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Suppliers"]</h1>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Create New Supplier"]</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label asp-for="Filter.Name" class="form-label">@Localizer["Name"]</label>
                <input asp-for="Filter.Name" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.Company" class="form-label">@Localizer["Company"]</label>
                <input asp-for="Filter.Company" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.ContactPerson" class="form-label">@Localizer["Contact Person"]</label>
                <input asp-for="Filter.ContactPerson" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.Phone" class="form-label">@Localizer["Phone"]</label>
                <input asp-for="Filter.Phone" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.Email" class="form-label">@Localizer["Email"]</label>
                <input asp-for="Filter.Email" class="form-control" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">@Localizer["Filter"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Clear"]</a>
            </div>
        </form>
    </div>
</div>

<table id="suppliersTable" class="table table-striped table-hover table-bordered align-middle w-100">
    <thead class="table-light">
        <tr>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Company"]</th>
            <th>@Localizer["Contact Person"]</th>
            <th>@Localizer["Tax Number"]</th>
            <th>@Localizer["Phone"]</th>
            <th>@Localizer["Email"]</th>
            <th>@Localizer["Status"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model.Suppliers)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@supplier.Id">@supplier.Name</a></td>
                <td>@(supplier.CompanyName ?? "-")</td>
                <td>@(supplier.ContactPerson ?? "-")</td>
                <td>@supplier.TaxNumber</td>
                <td>@(supplier.Phone ?? "-")</td>
                <td>@(supplier.Email ?? "-")</td>
                <td>
                    @if (supplier.IsActive)
                    {
                        <span class="badge bg-success">@Localizer["Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(function () {
            $('#suppliersTable').DataTable({
                language: window.dataTableLanguage
            });
        });
    </script>
}
