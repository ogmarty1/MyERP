                            <th>@Localizer["Customer"]</th>
                            <th>@Localizer["Company"]</th>
                            <th>@Localizer["Order Count"]</th>
                            <th>@Localizer["Total Revenue"]</th>
                            <th>@Localizer["Avg Order Value"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.TopCustomers)
                        {
                            <tr>
                                <td>@item.CustomerName</td>
                                <td>@(item.CompanyName ?? "-")</td>
                                <td>@item.OrderCount</td>
                                <td data-order="@item.TotalRevenue">@item.TotalRevenue.ToEuro()</td>
                                <td data-order="@item.AverageOrderValue">@item.AverageOrderValue.ToEuro()</td>
                            </tr>
