@model List<ERP.DataAccess.Models.Product>

@{
    ViewData["Title"] = Localizer["Products"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Products"]</h1>
    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">@Localizer["Create New Product"]</a>
    }
</div>

<table id="productsTable" class="table table-striped table-hover table-bordered align-middle w-100">
    <thead class="table-light">
        <tr>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Category"]</th>
            <th>@Localizer["Supplier"]</th>
            <th>@Localizer["Purchase Price"]</th>
            <th>@Localizer["Sale Price"]</th>
            <th>@Localizer["Quantity In Stock"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            var isLowStock = product.QuantityInStock <= product.MinimumQuantity;
            <tr class="@(isLowStock ? "table-danger" : "")">
                <td>@product.Name</td>
                <td>@product.Category.Name</td>
                <td>@(product.Supplier?.Name ?? "-")</td>
                <td data-order="@product.PurchasePrice">@product.PurchasePrice.ToEuro()</td>
                <td data-order="@product.SalePrice">@product.SalePrice.ToEuro()</td>
                <td>
                    @product.QuantityInStock
                    @if (isLowStock)
                    {
                        <span class="badge bg-danger ms-1">@Localizer["Low Stock"]</span>
                    }
                </td>
                <td>
                    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                    {
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-secondary" title="@Localizer["Edit"]">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(function () {
            $.fn.dataTable.Buttons.defaults.dom.button.className = 'btn btn-outline-secondary btn-sm me-1';
            $('#productsTable').DataTable({
                language: window.dataTableLanguage,
                columnDefs: [{ orderable: false, targets: -1 }],
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'copyHtml5', text: '<i class="bi bi-clipboard"></i> ' + window.dataTableButtonLabels.copy, exportOptions: { columns: ':not(:last-child)' } },
                    { extend: 'excelHtml5', text: '<i class="bi bi-file-earmark-excel"></i> ' + window.dataTableButtonLabels.excel, exportOptions: { columns: ':not(:last-child)' } },
                    { extend: 'print', text: '<i class="bi bi-printer"></i> ' + window.dataTableButtonLabels.print, exportOptions: { columns: ':not(:last-child)' } }
                ]
            });
        });
    </script>
}
