        @if (Model.ActiveType == ReportType.InventoryMovements)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Total Inflow"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@totalInflow</p>
                            </div>
                            <i class="bi bi-box-arrow-in-down kpi-icon text-success"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Total Outflow"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@totalOutflow</p>
                            </div>
                            <i class="bi bi-box-arrow-up kpi-icon text-danger"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Net Change"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@netChange</p>
                            </div>
                            <i class="bi bi-arrow-left-right kpi-icon text-primary"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Movements"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@Model.InventoryMovements.Count</p>
                            </div>
                            <i class="bi bi-list-ul kpi-icon text-info"></i>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.InventoryMovements.Count == 0)
            {
                <p class="text-muted">@Localizer["No inventory movements found for the selected range."]</p>
            }
            else
            {
                <div class="row g-3 mb-4">
                    <div class="col-lg-5">
                        <div class="card chart-card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="card-title text-muted mb-3">@Localizer["Movements by Type"]</h6>
                                <canvas id="inventoryMovementsChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <table id="inventoryMovementsTable" class="table table-striped table-bordered align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Product"]</th>
                            <th>@Localizer["SKU"]</th>
                            <th>@Localizer["Type"]</th>
                            <th>@Localizer["Quantity"]</th>
                            <th>@Localizer["Reason"]</th>
                            <th>@Localizer["Reference"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.InventoryMovements)
                        {
                            <tr>
                                <td data-order="@item.Date.Ticks">@item.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.ProductName</td>
                                <td>@item.SKU</td>
                                <td><span class="badge @BadgeClass(item.MovementType)">@MovementText(item.MovementType)</span></td>
                                <td>@item.Quantity</td>
                                <td>@(item.Reason ?? "-")</td>
                                <td>@item.SourceReference</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }

        @if (Model.ActiveType == ReportType.SalesByEmployee)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Total Revenue"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@employeeRevenue.ToEuro()</p>
                            </div>
                            <i class="bi bi-currency-exchange kpi-icon text-success"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Total Orders"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@employeeOrders</p>
                            </div>
                            <i class="bi bi-cart-check kpi-icon text-primary"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card kpi-card border-0 shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="card-title text-muted mb-1">@Localizer["Top Employee"]</h6>
                                <p class="card-text fs-4 fw-bold mb-0">@(topEmployee?.EmployeeName ?? "-")</p>
                            </div>
                            <i class="bi bi-award kpi-icon text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.SalesByEmployee.Count == 0)
            {
                <p class="text-muted">@Localizer["No sales found for the selected range."]</p>
            }
            else
            {
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div class="card chart-card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="card-title text-muted mb-3">@Localizer["Sales by Employee"]</h6>
                                <canvas id="salesByEmployeeChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <table id="salesByEmployeeTable" class="table table-striped table-bordered align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["Employee"]</th>
                            <th>@Localizer["Order Count"]</th>
                            <th>@Localizer["Total Revenue"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SalesByEmployee)
                        {
                            <tr>
                                <td>@item.EmployeeName</td>
                                <td>@item.OrderCount</td>
                                <td data-order="@item.TotalRevenue">@item.TotalRevenue.ToEuro()</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td>@Localizer["Total"]</td>
                            <td>@employeeOrders</td>
                            <td>@employeeRevenue.ToEuro()</td>
                        </tr>
                    </tfoot>
                </table>
