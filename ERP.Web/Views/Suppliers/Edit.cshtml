@model ERP.Web.Models.SupplierFormViewModel

@{
    ViewData["Title"] = Localizer["Edit Supplier"];
}

<h1>@Localizer["Edit Supplier"]</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @await Html.PartialAsync("_SupplierForm", Model)
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
