@model ERP.Web.Models.CustomerFormViewModel

@{
    ViewData["Title"] = Localizer["Create Customer"];
}

<h1>@Localizer["Create Customer"]</h1>

<form asp-action="Create" method="post" class="js-submit-loading">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @await Html.PartialAsync("_CustomerForm", Model)
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
