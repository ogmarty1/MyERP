</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        $(function () {
            var chartPalette = ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#0dcaf0', '#fd7e14', '#20c997'];

            @if (Model.SalesByPeriod.Count > 0)
            {
                <text>
                const periodLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesByPeriod.Select(i => i.PeriodLabel)));
                const periodRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesByPeriod.Select(i => i.TotalRevenue)));
                const periodColors = periodLabels.map(function (_, i) { return chartPalette[i % chartPalette.length]; });

                new Chart(document.getElementById('salesByPeriodChart'), {
                    type: 'bar',
                    data: {
                        labels: periodLabels,
                        datasets: [{
                            label: '@Html.Raw(Localizer["Revenue (€)"])',
                            data: periodRevenue,
                            backgroundColor: periodColors,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
                </text>
            }

            @if (Model.SalesByCategory.Count > 0)
            {
                <text>
                const categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesByCategory.Select(i => i.CategoryName)));
                const categoryRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesByCategory.Select(i => i.TotalRevenue)));
                const categoryColors = categoryLabels.map(function (_, i) { return chartPalette[i % chartPalette.length]; });

                new Chart(document.getElementById('salesByCategoryChart'), {
                    type: 'doughnut',
                    data: {
                        labels: categoryLabels,
                        datasets: [{
                            data: categoryRevenue,
                            backgroundColor: categoryColors
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
                </text>
            }

            @if (Model.PurchasesByPeriod.Count > 0)
            {
                <text>
                const purchasePeriodLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PurchasesByPeriod.Select(i => i.PeriodLabel)));
                const purchasePeriodSpend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PurchasesByPeriod.Select(i => i.TotalSpend)));
                const purchasePeriodColors = purchasePeriodLabels.map(function (_, i) { return chartPalette[i % chartPalette.length]; });

                new Chart(document.getElementById('purchasesByPeriodChart'), {
                    type: 'bar',
                    data: {
                        labels: purchasePeriodLabels,
                        datasets: [{
                            label: '@Html.Raw(Localizer["Spend (€)"])',
                            data: purchasePeriodSpend,
                            backgroundColor: purchasePeriodColors,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
                </text>
            }

            @if (Model.PurchasesBySupplier.Count > 0)
            {
                <text>
                const supplierLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PurchasesBySupplier.Select(i => i.SupplierName)));
                const supplierSpend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PurchasesBySupplier.Select(i => i.TotalSpend)));
                const supplierColors = supplierLabels.map(function (_, i) { return chartPalette[i % chartPalette.length]; });

                new Chart(document.getElementById('purchasesBySupplierChart'), {
                    type: 'doughnut',
                    data: {
                        labels: supplierLabels,
                        datasets: [{
                            data: supplierSpend,
                            backgroundColor: supplierColors
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
                </text>
            }

            @if (Model.LowStock.Count > 0)
            {
                var lowStockTop = Model.LowStock.Take(10).ToList();
                <text>
                const lowStockLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lowStockTop.Select(i => i.ProductName)));
                const lowStockData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lowStockTop.Select(i => i.Shortfall)));
                const lowStockColors = lowStockLabels.map(function (_, i) { return chartPalette[i % chartPalette.length]; });

                new Chart(document.getElementById('lowStockChart'), {
                    type: 'bar',
                    data: {
                        labels: lowStockLabels,
                        datasets: [{
                            label: '@Html.Raw(Localizer["Shortfall"])',
                            data: lowStockData,
                            backgroundColor: lowStockColors,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
                </text>
            }

            @if (Model.ProductProfitability.Count > 0)
            {
                var profitabilityTop = Model.ProductProfitability.OrderByDescending(i => i.GrossProfit).Take(10).ToList();
                <text>
                const profitabilityLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(profitabilityTop.Select(i => i.ProductName)));
                const profitabilityData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(profitabilityTop.Select(i => i.GrossProfit)));
                const profitabilityColors = profitabilityLabels.map(function (_, i) { return chartPalette[i % chartPalette.length]; });

                new Chart(document.getElementById('profitabilityChart'), {
                    type: 'bar',
                    data: {
                        labels: profitabilityLabels,
                        datasets: [{
                            label: '@Html.Raw(Localizer["Gross Profit (€)"])',
                            data: profitabilityData,
                            backgroundColor: profitabilityColors,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
                </text>
            }

            @if (Model.TopCustomers.Count > 0)
            {
                var topCustomersTop = Model.TopCustomers.Take(10).ToList();
                <text>
                const topCustomersLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(topCustomersTop.Select(i => i.CustomerName)));
                const topCustomersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(topCustomersTop.Select(i => i.TotalRevenue)));
                const topCustomersColors = topCustomersLabels.map(function (_, i) { return chartPalette[i % chartPalette.length]; });

                new Chart(document.getElementById('topCustomersChart'), {
                    type: 'bar',
                    data: {
                        labels: topCustomersLabels,
                        datasets: [{
                            label: '@Html.Raw(Localizer["Revenue (€)"])',
                            data: topCustomersData,
                            backgroundColor: topCustomersColors,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
                </text>
            }

            @if (Model.InventoryMovements.Count > 0)
            {
                <text>
                const movementTypeLabels = ['@Html.Raw(Localizer["Inflow"])', '@Html.Raw(Localizer["Outflow"])', '@Html.Raw(Localizer["Adjustment"])'];
                const movementTypeData = [@totalInflow, @totalOutflow, @Model.InventoryMovements.Where(m => m.MovementType == MovementType.Adjustment).Sum(m => m.Quantity)];

                new Chart(document.getElementById('inventoryMovementsChart'), {
                    type: 'doughnut',
                    data: {
                        labels: movementTypeLabels,
                        datasets: [{
                            data: movementTypeData,
                            backgroundColor: ['#198754', '#dc3545', '#6c757d']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
                </text>
            }

            @if (Model.SalesByEmployee.Count > 0)
            {
                <text>
                const employeeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesByEmployee.Select(i => i.EmployeeName)));
                const employeeRevenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesByEmployee.Select(i => i.TotalRevenue)));
                const employeeColors = employeeLabels.map(function (_, i) { return chartPalette[i % chartPalette.length]; });

                new Chart(document.getElementById('salesByEmployeeChart'), {
                    type: 'bar',
                    data: {
                        labels: employeeLabels,
                        datasets: [{
                            label: '@Html.Raw(Localizer["Revenue (€)"])',
                            data: employeeRevenueData,
                            backgroundColor: employeeColors,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
                </text>
            }

            $.fn.dataTable.Buttons.defaults.dom.button.className = 'btn btn-outline-secondary btn-sm me-1';

            var reportTableOptions = {
                language: window.dataTableLanguage,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bi bi-file-earmark-excel"></i> ' + window.dataTableButtonLabels.excel
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bi bi-file-earmark-pdf"></i> ' + window.dataTableButtonLabels.pdf
                    },
                    {
                        extend: 'print',
                        text: '<i class="bi bi-printer"></i> ' + window.dataTableButtonLabels.print
                    }
                ]
            };

            ['#salesByPeriodTable', '#salesByCategoryTable', '#purchasesByPeriodTable', '#purchasesBySupplierTable',
             '#lowStockTable', '#profitabilityTable', '#topCustomersTable', '#inventoryMovementsTable', '#salesByEmployeeTable']
                .forEach(function (selector) {
                    if ($(selector).length) {
                        $(selector).DataTable(reportTableOptions);
                    }
                });
        });
    </script>
}
