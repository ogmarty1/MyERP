@model ERP.Web.Models.ProductFormViewModel

@{
    ViewData["Title"] = Localizer["Create Product"];
}

<h1>@Localizer["Create Product"]</h1>

<form asp-action="Create" method="post" class="js-submit-loading">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @await Html.PartialAsync("_ProductForm", Model)
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
