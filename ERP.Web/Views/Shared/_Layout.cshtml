@using System.Globalization
@using System.Security.Claims
@{
    var currentLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    bool IsActiveNav(string controller, string action = "Index") =>
        currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) &&
        currentAction.Equals(action, StringComparison.OrdinalIgnoreCase);
    string NavClass(string controller, string action = "Index") => IsActiveNav(controller, action)
        ? "nav-link text-dark active"
        : "nav-link text-dark";
    string NavCurrent(string controller, string action = "Index") => IsActiveNav(controller, action)
        ? "page"
        : "false";
}
<!DOCTYPE html>
<html lang="@currentLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ERP.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ERP.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="@NavClass("Home")" aria-current="@NavCurrent("Home")" asp-area="" asp-controller="Home" asp-action="Index">@Localizer["Home"]</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Products")" aria-current="@NavCurrent("Products")" asp-area="" asp-controller="Products" asp-action="Index">@Localizer["Products"]</a>
                            </li>
                            @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="@NavClass("Customers")" aria-current="@NavCurrent("Customers")" asp-area="" asp-controller="Customers" asp-action="Index">@Localizer["Customers"]</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="@NavClass("Orders")" aria-current="@NavCurrent("Orders")" asp-area="" asp-controller="Orders" asp-action="Index">@Localizer["Orders"]</a>
                            </li>
                            @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="@NavClass("Categories")" aria-current="@NavCurrent("Categories")" asp-area="" asp-controller="Categories" asp-action="Index">@Localizer["Categories"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="@NavClass("Suppliers")" aria-current="@NavCurrent("Suppliers")" asp-area="" asp-controller="Suppliers" asp-action="Index">@Localizer["Suppliers"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="@NavClass("Reports")" aria-current="@NavCurrent("Reports")" asp-area="" asp-controller="Reports" asp-action="Index">@Localizer["Reports"]</a>
                                </li>
                            }
                        }
                        <li class="nav-item">
                            <a class="@NavClass("Home", "Privacy")" aria-current="@NavCurrent("Home", "Privacy")" asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["Privacy"]</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        <li class="nav-item d-flex align-items-center me-2">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Language">
                                <a class="btn btn-outline-secondary @(currentLang == "en" ? "active" : "")" asp-controller="Language" asp-action="Set" asp-route-culture="en" asp-route-returnUrl="@returnUrl">EN</a>
                                <a class="btn btn-outline-secondary @(currentLang == "bg" ? "active" : "")" asp-controller="Language" asp-action="Set" asp-route-culture="bg" asp-route-returnUrl="@returnUrl">BG</a>
                            </div>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-2 gap-1">
                                <span class="text-dark">@Localizer["Signed in as"] <strong>@User.Identity.Name</strong></span>
                                @foreach (var role in User.FindAll(ClaimTypes.Role).Select(c => c.Value).Distinct())
                                {
                                    <span class="badge bg-primary">@role</span>
                                }
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="@Localizer["Log Out"]">
                                        <i class="bi bi-box-arrow-right"></i> @Localizer["Log Out"]
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">@Localizer["Log In"]</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <script>window.__toastSuccess = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage));</script>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <script>window.__toastError = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage));</script>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ERP.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["Privacy"]</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: 'toast-top-right',
            timeOut: 5000
        };
        if (window.__toastSuccess) { toastr.success(window.__toastSuccess); }
        if (window.__toastError) { toastr.error(window.__toastError); }
    </script>
    <script>
        window.dataTableLanguage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            search = Localizer["Search:"].Value,
            lengthMenu = Localizer["Show _MENU_ entries"].Value,
            zeroRecords = Localizer["No matching records found"].Value,
            info = Localizer["Showing _START_ to _END_ of _TOTAL_ entries"].Value,
            infoEmpty = Localizer["Showing 0 to 0 of 0 entries"].Value,
            infoFiltered = Localizer["(filtered from _MAX_ total entries)"].Value,
            paginate = new
            {
                first = Localizer["First"].Value,
                last = Localizer["Last"].Value,
                next = Localizer["Next"].Value,
                previous = Localizer["Previous"].Value
            }
        }));
        window.dataTableButtonLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            copy = Localizer["Copy"].Value,
            excel = Localizer["Excel"].Value,
            print = Localizer["Print"].Value
        }));
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
