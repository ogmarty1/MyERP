@model ERP.Web.Models.CustomersIndexViewModel

@{
    ViewData["Title"] = Localizer["Customers"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Customers"]</h1>
    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">@Localizer["Create New Customer"]</a>
    }
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label asp-for="Filter.Name" class="form-label">@Localizer["Name"]</label>
                <input asp-for="Filter.Name" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Filter.Company" class="form-label">@Localizer["Company"]</label>
                <input asp-for="Filter.Company" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.Phone" class="form-label">@Localizer["Phone"]</label>
                <input asp-for="Filter.Phone" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.Email" class="form-label">@Localizer["Email"]</label>
                <input asp-for="Filter.Email" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Filter.Address" class="form-label">@Localizer["Address"]</label>
                <input asp-for="Filter.Address" class="form-control" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">@Localizer["Filter"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Clear"]</a>
            </div>
        </form>
    </div>
</div>

<table id="customersTable" class="table table-striped table-hover table-bordered align-middle w-100">
    <thead class="table-light">
        <tr>
            <th></th>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Company"]</th>
            <th>@Localizer["Phone"]</th>
            <th>@Localizer["Email"]</th>
            <th>@Localizer["Address"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model.Customers)
        {
            <tr>
                <td></td>
                <td><a asp-action="Details" asp-route-id="@customer.Id">@customer.Name</a></td>
                <td>@(customer.CompanyName ?? "-")</td>
                <td>@(customer.Phone ?? "-")</td>
                <td>@(customer.Email ?? "-")</td>
                <td>@(customer.Address ?? "-")</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(function () {
            function selectedOrAll(dt) {
                return dt.rows({ selected: true }).count() > 0 ? true : null;
            }

            $.fn.dataTable.Buttons.defaults.dom.button.className = 'btn btn-outline-secondary btn-sm me-1';

            $('#customersTable').DataTable({
                language: window.dataTableLanguage,
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, className: 'select-checkbox', targets: 0 }
                ],
                select: { style: 'multi', selector: 'td:first-child' },
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bi bi-file-earmark-excel"></i> ' + window.dataTableButtonLabels.excel,
                        exportOptions: { columns: ':not(:first-child)', modifier: {} },
                        action: function (e, dt, button, config) {
                            config.exportOptions.modifier.selected = selectedOrAll(dt);
                            $.fn.dataTable.ext.buttons.excelHtml5.action.call(this, e, dt, button, config);
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bi bi-file-earmark-pdf"></i> ' + window.dataTableButtonLabels.pdf,
                        exportOptions: { columns: ':not(:first-child)', modifier: {} },
                        action: function (e, dt, button, config) {
                            config.exportOptions.modifier.selected = selectedOrAll(dt);
                            $.fn.dataTable.ext.buttons.pdfHtml5.action.call(this, e, dt, button, config);
                        }
                    },
                    {
                        extend: 'print',
                        text: '<i class="bi bi-printer"></i> ' + window.dataTableButtonLabels.print,
                        exportOptions: { columns: ':not(:first-child)', modifier: {} },
                        action: function (e, dt, button, config) {
                            config.exportOptions.modifier.selected = selectedOrAll(dt);
                            $.fn.dataTable.ext.buttons.print.action.call(this, e, dt, button, config);
                        }
                    }
                ]
            });
        });
    </script>
}
