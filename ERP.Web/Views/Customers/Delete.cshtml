@model ERP.DataAccess.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<h1>Delete Customer</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<p>Are you sure you want to delete this customer?</p>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Company</dt>
    <dd class="col-sm-10">@(Model.CompanyName ?? "-")</dd>

    <dt class="col-sm-2">Tax Number</dt>
    <dd class="col-sm-10">@Model.TaxNumber</dd>

    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@(Model.Phone ?? "-")</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@(Model.Email ?? "-")</dd>

    <dt class="col-sm-2">Address</dt>
    <dd class="col-sm-10">@(Model.Address ?? "-")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
