@model List<ERP.DataAccess.Models.Supplier>

@{
    ViewData["Title"] = Localizer["Suppliers"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Suppliers"]</h1>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Create New Supplier"]</a>
</div>

<table id="suppliersTable" class="table table-striped table-hover table-bordered align-middle w-100">
    <thead class="table-light">
        <tr>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Company"]</th>
            <th>@Localizer["Contact Person"]</th>
            <th>@Localizer["Tax Number"]</th>
            <th>@Localizer["Phone"]</th>
            <th>@Localizer["Email"]</th>
            <th>@Localizer["Status"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Name</td>
                <td>@(supplier.CompanyName ?? "-")</td>
                <td>@(supplier.ContactPerson ?? "-")</td>
                <td>@supplier.TaxNumber</td>
                <td>@(supplier.Phone ?? "-")</td>
                <td>@(supplier.Email ?? "-")</td>
                <td>
                    @if (supplier.IsActive)
                    {
                        <span class="badge bg-success">@Localizer["Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                    }
                </td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-secondary" title="@Localizer["Edit"]">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@supplier.Id" method="post" class="d-inline js-delete-form"
                              data-confirm-title="@Localizer["Delete Supplier"]"
                              data-confirm-text="@Localizer["Are you sure you want to delete this supplier?"] @Localizer["This action cannot be undone."]"
                              data-confirm-button="@Localizer["Yes, delete it"]"
                              data-cancel-button="@Localizer["Cancel"]">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="@Localizer["Delete"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(function () {
            $('#suppliersTable').DataTable({
                language: window.dataTableLanguage,
                columnDefs: [{ orderable: false, targets: -1 }]
            });
        });
    </script>
}
