@model List<ERP.DataAccess.Models.User>

@{
    ViewData["Title"] = Localizer["Users"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Users"]</h1>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Create New User"]</a>
</div>

<table id="usersTable" class="table table-striped table-hover table-bordered align-middle w-100">
    <thead class="table-light">
        <tr>
            <th>@Localizer["User ID"]</th>
            <th>@Localizer["Full Name"]</th>
            <th>@Localizer["Email"]</th>
            <th>@Localizer["Role"]</th>
            <th>@Localizer["Contact Details"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td><a asp-action="Details" asp-route-id="@user.Id">@user.FullName</a></td>
                <td>@user.Email</td>
                <td>@string.Join(", ", user.UserRoles.Select(ur => ur.Role.Name))</td>
                <td>@(user.Phone ?? "-")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary" title="@Localizer["View"]">
                        <i class="bi bi-eye"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(function () {
            $('#usersTable').DataTable({
                language: window.dataTableLanguage,
                columnDefs: [{ orderable: false, targets: -1 }]
            });
        });
    </script>
}
