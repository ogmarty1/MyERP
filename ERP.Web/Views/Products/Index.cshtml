@model List<ERP.DataAccess.Models.Product>

@{
    ViewData["Title"] = Localizer["Products"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Products"]</h1>
    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">@Localizer["Create New Product"]</a>
    }
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Category"]</th>
            <th>@Localizer["Supplier"]</th>
            <th>@Localizer["Purchase Price"]</th>
            <th>@Localizer["Sale Price"]</th>
            <th>@Localizer["Quantity In Stock"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            var isLowStock = product.QuantityInStock <= product.MinimumQuantity;
            <tr class="@(isLowStock ? "table-danger" : "")">
                <td>@product.Name</td>
                <td>@product.Category.Name</td>
                <td>@(product.Supplier?.Name ?? "-")</td>
                <td>@product.PurchasePrice.ToEuro()</td>
                <td>@product.SalePrice.ToEuro()</td>
                <td>
                    @product.QuantityInStock
                    @if (isLowStock)
                    {
                        <span class="badge bg-danger ms-1">@Localizer["Low Stock"]</span>
                    }
                </td>
                <td>
                    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Edit"]</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
